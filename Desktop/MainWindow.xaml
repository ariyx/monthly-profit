<Window x:Class="Profit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مدیریت سود ماهانه" Width="1200" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="16">
  <Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><DockPanel>
   <StackPanel DockPanel.Dock="Right"><TextBlock Text="مدیریت سود ماهانه" FontSize="23"/><TextBlock Text="اطلاعات محلی · همه مبلغ‌ها ریال" Foreground="#52647B" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="ماه شمسی" VerticalAlignment="Center"/><ComboBox x:Name="Months" Width="130" SelectionChanged="MonthChanged"/><Button Content="ماه جدید" Click="NewMonth"/><Button Content="کپی به ماه جدید" Click="CloneMonth"/></StackPanel>
  </DockPanel></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="Transparent"><TextBlock x:Name="Status" Text="آماده" TextWrapping="Wrap"/></StatusBar>
  <TabControl Background="Transparent" BorderThickness="0" Margin="6">
   <TabItem Header="داشبورد ماهانه"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12">
    <UniformGrid Columns="3">
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="فروش کل"/><TextBlock x:Name="Sales" FontSize="26" Margin="0,12" FlowDirection="LeftToRight"/><TextBlock Text="نقدی و چکی" Foreground="#52647B"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="سود پیش از هزینه ثابت"/><TextBlock x:Name="Profit" FontSize="26" Margin="0,12" FlowDirection="LeftToRight"/><TextBlock x:Name="MarginLabel" Foreground="#52647B"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="نتیجه پس از هزینه ثابت"/><TextBlock x:Name="Net" FontSize="26" Margin="0,12" FlowDirection="LeftToRight"/><TextBlock x:Name="NetLabel"/></StackPanel></Border>
    </UniformGrid>
    <UniformGrid Columns="2">
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="خرید و ترکیب فروش" FontSize="17" Margin="0,0,0,10"/><TextBlock x:Name="Breakdown" LineHeight="30" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="هزینه ثابت همین ماه — ریال"/><TextBox x:Name="Fixed" FlowDirection="LeftToRight"/><Button Content="ثبت هزینه ثابت" Click="SaveFixed" Style="{StaticResource Primary}" HorizontalAlignment="Right"/><TextBlock x:Name="FixedHint" TextWrapping="Wrap" Foreground="#52647B"/></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="سودآوری برندها" FontSize="17" Margin="0,0,0,14"/><DataGrid x:Name="BrandsGrid" MaxHeight="400"><DataGrid.Columns><DataGridTextColumn Header="رتبه سود" Binding="{Binding Rank}" Width="90"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="*"/><DataGridTextColumn Header="تعداد کالا" Binding="{Binding Count}" Width="90"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="160"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="160"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="110"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="اطلاعات ماه و کالاها"><DockPanel Margin="6,16">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}"/><Button Content="ویرایش انتخاب‌شده" Click="EditProduct"/><Button Content="حذف انتخاب‌شده" Click="DeleteProduct"/><Button Content="بازگرداندن حذف آخر" Click="UndoDelete"/><Button Content="ورود از اکسل" Click="ImportExcel"/><Button Content="خروجی اکسل" Click="ExportExcel"/></WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="هر کالا قیمت و درصدهای مستقل دارد. با دوبار کلیک روی ردیف، جزئیات آن را ویرایش کنید." Margin="4,12" Foreground="#52647B" TextWrapping="Wrap"/>
    <DataGrid x:Name="ItemsGrid" MouseDoubleClick="EditProduct"><DataGrid.Columns><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="130"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="قیمت خرید واحد" Binding="{Binding PriceText}" Width="145"/><DataGridTextColumn Header="مقدار" Binding="{Binding QuantityText}" Width="85"/><DataGridTextColumn Header="فروش کل" Binding="{Binding SalesText}" Width="145"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="145"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="105"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="گزارش ماه‌ها"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><Button Content="چاپ گزارش ماه انتخاب‌شده / PDF" Click="PrintReport"/><Button Content="خروجی اکسل ماه انتخاب‌شده" Click="ExportExcel"/></WrapPanel><TextBlock DockPanel.Dock="Bottom" Margin="4,12" TextWrapping="Wrap" Text="حاشیه سود کل = مجموع سود ناخالص ÷ مجموع فروش. هزینه ثابت یک‌بار در هر ماه کسر می‌شود."/><DataGrid x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="ماه" Binding="{Binding Key}" Width="100"/><DataGridTextColumn Header="خرید" Binding="{Binding CostText}" Width="*"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="*"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="*"/><DataGridTextColumn Header="هزینه ثابت" Binding="{Binding FixedText}" Width="*"/><DataGridTextColumn Header="نتیجه ماه" Binding="{Binding NetText}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="پشتیبان و راهنما"><ScrollViewer><StackPanel Margin="18">
    <TextBlock Text="پشتیبان‌گیری و بازیابی" FontSize="19" Margin="0,8"/><WrapPanel><Button Content="ذخیره نسخه پشتیبان" Click="Backup" Style="{StaticResource Primary}"/><Button Content="بازیابی پشتیبان" Click="Restore"/><Button Content="بازکردن پوشه اطلاعات" Click="OpenDataFolder"/></WrapPanel>
    <TextBlock Text="بازیابی، همه ماه‌های فعلی را با نسخه پشتیبان جایگزین می‌کند. قبل از آن، برنامه خودکار از اطلاعات فعلی پشتیبان می‌گیرد." TextWrapping="Wrap" Margin="0,12"/>
    <TextBlock Text="قواعد محاسبات" FontSize="19" Margin="0,14"/>
    <TextBlock TextWrapping="Wrap" LineHeight="30" Text="• تخفیف خرید و آفر هر دو از مبلغ اولیه خرید محاسبه می‌شوند.&#10;• سود اضافه روی قیمت خرید واحد اولیه اعمال می‌شود.&#10;• تمام مقدار خرید فروخته می‌شود؛ سهم نقدی و چکی در مجموع ۱۰۰٪ است.&#10;• تخفیف نقدی فقط از بخش نقدی فروش کسر می‌شود؛ مدت چک هزینه‌ای ندارد.&#10;• سود ناخالص برابر فروش منهای بهای خرید است؛ هزینه ثابت ماه فقط یک‌بار کم می‌شود.&#10;• حاشیه سودِ فروش صفر تعریف‌نشده است؛ زیان با علامت منفی حفظ می‌شود.&#10;• محاسبات با اعداد ده‌دهی انجام می‌شوند؛ نمایش ریال حداکثر دو رقم اعشار دارد.&#10;• تعداد هر کالا می‌تواند اعشاری باشد؛ جمع مقدار کالاهای با واحد متفاوت شاخص مالی نیست."/>
    <TextBlock Text="داده آزمایشی" FontSize="19" Margin="0,18,0,8"/><Button Content="افزودن نمونه اکسل بررسی‌شده به ماه خالی" Click="LoadSample" HorizontalAlignment="Right"/><TextBlock Text="داده نمونه شامل شش ردیف بررسی‌شده است؛ نام کالاها نمونه‌اند و باید با نام واقعی جایگزین شوند." TextWrapping="Wrap" Margin="0,8"/>
    <TextBlock x:Name="VersionLabel" Text="نسخه اولیه ۰٫۱ · قواعد محاسبات ۱ · ویندوز ۶۴ بیتی" Foreground="#52647B" Margin="0,20"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
