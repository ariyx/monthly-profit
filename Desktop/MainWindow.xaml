<Window x:Class="Profit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="شرکت متحد توزیع ایرانیان | مدیریت سود ماهانه" Width="1280" Height="860" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#151A25" CornerRadius="16" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="2" Width="126" Height="72" Background="White" CornerRadius="9" Padding="6"><Image Source="pack://application:,,,/Assets/company-logo-cropped.png" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="شرکت متحد توزیع ایرانیان" FontSize="23" FontWeight="SemiBold" Foreground="White" TextAlignment="Right"/><TextBlock Text="سامانه مدیریت سود ماهانه" Foreground="#CBD5E1" TextAlignment="Right"/></StackPanel><Border Grid.Column="0" Background="White" CornerRadius="9" Padding="7,3" VerticalAlignment="Center"><WrapPanel FlowDirection="RightToLeft"><Button Content="مدیریت ماه" Click="OpenMonthMenu"><Button.ContextMenu><ContextMenu FlowDirection="RightToLeft"><MenuItem Header="ماه جدید" Click="NewMonth"/><MenuItem Header="کپی ماه" Click="CloneMonth"/><Separator/><MenuItem Header="ویرایش نام ماه" Click="EditMonth"/><MenuItem Header="بستن / باز کردن ماه" Click="ToggleMonthClosed"/><MenuItem Header="حذف ماه" Click="DeleteMonth"/></ContextMenu></Button.ContextMenu></Button><ComboBox x:Name="Months" Width="112" SelectionChanged="MonthChanged"/><TextBlock x:Name="ClosedBadge" Text="ماه باز" Foreground="#475467" VerticalAlignment="Center" Margin="6"/></WrapPanel></Border></Grid></Border>
<TabControl Grid.Row="1" TabStripPlacement="Right" Margin="0,18,0,6"><TabItem Header="داشبورد"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><StackPanel Margin="6,0,6,14"><TextBlock Text="نمای کلی ماه" Style="{StaticResource SectionTitle}"/><TextBlock Text="مهم‌ترین شاخص‌های مالی ماه انتخاب‌شده" Style="{StaticResource MutedText}"/></StackPanel><UniformGrid Columns="3"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="فروش کل" Style="{StaticResource MutedText}"/><TextBlock x:Name="Sales" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,5"/><TextBlock Text="فروش نقدی و چکی" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="سود پیش از هزینه ثابت" Style="{StaticResource MutedText}"/><TextBlock x:Name="Profit" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,5"/><TextBlock x:Name="MarginLabel" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="نتیجه پس از هزینه ثابت" Style="{StaticResource MutedText}"/><TextBlock x:Name="Net" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,5"/><TextBlock x:Name="NetLabel" Style="{StaticResource MutedText}"/></StackPanel></Border></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="ترکیب عملکرد" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="Breakdown" Foreground="#172033" LineHeight="29" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="هزینه ثابت ماه" Style="{StaticResource SectionTitle}"/><TextBox x:Name="Fixed" Margin="0,11,0,5"/><WrapPanel FlowDirection="RightToLeft"><Button Content="ثبت هزینه" Click="SaveFixed" Style="{StaticResource Primary}"/><Button Content="ریز هزینه‌ها" Click="FixedExpenses"/><TextBlock x:Name="FixedHint" Style="{StaticResource MutedText}" Width="180" TextWrapping="Wrap"/></WrapPanel></StackPanel></Border></Grid><Border x:Name="NetNotice" Style="{StaticResource Panel}"><StackPanel><TextBlock x:Name="NetNoticeTitle" FontWeight="SemiBold"/><TextBlock x:Name="NetNoticeText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><StackPanel HorizontalAlignment="Right" FlowDirection="RightToLeft"><TextBlock Text="سودآوری برندها" Style="{StaticResource SectionTitle}" TextAlignment="Right"/><TextBlock Text="رتبه‌بندی بر اساس سود ناخالص" Style="{StaticResource MutedText}" TextAlignment="Right"/></StackPanel><DataGrid x:Name="BrandsGrid" MaxHeight="360"><DataGrid.Columns><DataGridTextColumn Header="رتبه" Binding="{Binding Rank}" Width="64"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.45*" MinWidth="130"/><DataGridTextColumn Header="تعداد کالا" Binding="{Binding Count}" Width="90"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="1.25*" MinWidth="120"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="1.25*" MinWidth="120"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="105"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="کالاها و فروش"><DockPanel Margin="22"><Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="کالاهای ماه جاری" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ProductCount" Style="{StaticResource MutedText}"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}"/><Button Content="ویرایش" Click="EditProduct"/><Button Content="حذف" Click="DeleteProduct"/><Button Content="بازگردانی حذف" Click="UndoDelete"/></WrapPanel></Grid><WrapPanel FlowDirection="RightToLeft"><TextBox x:Name="ProductSearch" Width="240" ToolTip="جست‌وجوی نام کالا یا برند" TextChanged="ProductFilterChanged"/><ComboBox x:Name="BrandFilter" Width="160" SelectionChanged="ProductFilterChanged"/><Button Content="پاک کردن جست‌وجو" Click="ClearProductFilter"/></WrapPanel></StackPanel></Border><Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="13"><DockPanel><TextBlock Text="ورود یا خروجی فایل Excel" FontWeight="SemiBold"/><WrapPanel DockPanel.Dock="Left"><Button Content="ورود از اکسل" Click="ImportExcel"/><Button Content="خروجی ماه فعال" Click="ExportExcel" Style="{StaticResource Primary}"/></WrapPanel></DockPanel></Border><Grid><DataGrid x:Name="ItemsGrid" MouseDoubleClick="EditProduct"><DataGrid.Columns><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.05*" MinWidth="110"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="1.65*" MinWidth="155"/><DataGridTextColumn Header="قیمت خرید واحد" Binding="{Binding PriceText}" Width="1.15*" MinWidth="125"/><DataGridTextColumn Header="مقدار" Binding="{Binding QuantityText}" Width="85"/><DataGridTextColumn Header="بهای تمام‌شده" Binding="{Binding CostText}" Width="1.15*" MinWidth="125"/><DataGridTextColumn Header="فروش کل" Binding="{Binding SalesText}" Width="1.15*" MinWidth="125"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="1.15*" MinWidth="125"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="105"/></DataGrid.Columns></DataGrid><Border x:Name="ItemsEmpty" Visibility="Collapsed" Background="White"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320"><TextBlock Text="هنوز کالایی برای نمایش نیست" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="برای شروع، اولین کالا را در همین ماه ثبت کنید." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}"/></StackPanel></Border></Grid></DockPanel></TabItem>
<TabItem Header="گزارش‌ها"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><Border Style="{StaticResource Panel}"><StackPanel FlowDirection="RightToLeft"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="گزارش ماه‌ها" Style="{StaticResource SectionTitle}" TextAlignment="Right"/><TextBlock Text="مقایسه عملکرد، فیلتر بازه و روند مالی" Style="{StaticResource MutedText}" TextAlignment="Right"/></StackPanel><WrapPanel Grid.Column="1" FlowDirection="RightToLeft"><Button Content="چاپ ماه فعال" Click="PrintReport"/><Button Content="خروجی ماه فعال" Click="ExportExcel"/><Button Content="خروجی بازه" Click="ExportRange" Style="{StaticResource Primary}"/></WrapPanel></Grid><WrapPanel FlowDirection="RightToLeft"><TextBlock Text="آمار بازه ماه:" FontWeight="SemiBold"/><TextBlock Text="از"/><ComboBox x:Name="HistoryFrom" Width="110" SelectionChanged="HistoryFilterChanged"/><TextBlock Text="تا"/><ComboBox x:Name="HistoryTo" Width="110" SelectionChanged="HistoryFilterChanged"/><Button Content="پاک کردن فیلتر" Click="ClearHistoryFilter"/></WrapPanel></StackPanel></Border><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="فروش بازه" Style="{StaticResource MutedText}"/><TextBlock x:Name="RangeSales" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="سود ناخالص بازه" Style="{StaticResource MutedText}"/><TextBlock x:Name="RangeProfit" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock x:Name="RangeOutcome" Text="نتیجه نهایی" Style="{StaticResource MutedText}"/><TextBlock x:Name="RangeNet" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border></Grid><Border Style="{StaticResource Panel}"><StackPanel><TextBlock x:Name="HistorySummary" Text="همه ماه‌های ثبت‌شده" TextWrapping="Wrap"/><WrapPanel FlowDirection="RightToLeft"><CheckBox x:Name="TrendSales" Content="فروش کل" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged"/><CheckBox x:Name="TrendProfit" Content="سود ناخالص" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged"/><CheckBox x:Name="TrendNet" Content="نتیجه نهایی" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged"/></WrapPanel><Grid Height="270"><Canvas x:Name="TrendCanvas" SizeChanged="TrendSizeChanged" Background="#FAFBFD"/><TextBlock x:Name="TrendEmpty" Visibility="Collapsed" Text="برای نمایش روند حداقل دو ماه لازم است." HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></StackPanel></Border><DataGrid x:Name="HistoryGrid" Margin="6"><DataGrid.Columns><DataGridTextColumn Header="ماه" Binding="{Binding Key}" Width="90"/><DataGridTextColumn Header="بهای تمام‌شده" Binding="{Binding CostText}" Width="*"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="*"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="*"/><DataGridTextColumn Header="هزینه ثابت" Binding="{Binding FixedText}" Width="*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding OutcomeText}" Width="90"/><DataGridTextColumn Header="نتیجه ماه" Binding="{Binding NetText}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></TabItem>
<TabItem Header="پشتیبان و راهنما"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="LastBackup" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><WrapPanel><Button Content="ذخیره نسخه پشتیبان" Click="Backup" Style="{StaticResource Primary}"/><Button Content="بازیابی پشتیبان" Click="Restore"/><Button Content="بازکردن پوشه اطلاعات" Click="OpenDataFolder"/><Button Content="بازکردن پشتیبان‌ها" Click="OpenBackupFolder"/></WrapPanel><CheckBox x:Name="AutoBackup" Content="پشتیبان خودکار محلی هنگام خروج (حداکثر ۸ نسخه)" Checked="AutoBackupChanged" Unchecked="AutoBackupChanged"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="درباره"><StackPanel Margin="28"><TextBlock Text="شرکت متحد توزیع ایرانیان" Style="{StaticResource SectionTitle}"/><TextBlock Text="سامانه مدیریت سود ماهانه"/><TextBlock x:Name="AboutVersion" Style="{StaticResource MutedText}" Margin="0,16,0,0"/><TextBlock Text="Powered by Webilo (Sadegh Malekzadeh)" Style="{StaticResource MutedText}" Margin="0,12,0,0"/><Button Content="کپی اطلاعات نسخه" Click="CopyVersion" HorizontalAlignment="Right"/></StackPanel></TabItem></TabControl>
<Border Grid.Row="2" Background="Transparent" Padding="8,5"><TextBlock x:Name="Status" Text="آماده" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></Border></Grid></Window>
