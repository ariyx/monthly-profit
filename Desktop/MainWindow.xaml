</StackPanel>
</Border>
<Border Style="{StaticResource MetricCard}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="سود پیش از هزینه ثابت" Style="{StaticResource MutedText}"/>
