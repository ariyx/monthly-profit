<Window x:Class="Profit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="شرکت متحد توزیع ایرانیان | مدیریت سود ماهانه" Width="1280" Height="860" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
<Grid Margin="20">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Border Grid.Row="0" Background="#151A25" CornerRadius="16" Padding="16,12">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="2" Width="126" Height="72" Background="White" CornerRadius="9" Padding="6">
<Image Source="pack://application:,,,/Assets/company-logo-cropped.png" Stretch="Uniform"/>
</Border>
<StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
<TextBlock Text="شرکت متحد توزیع ایرانیان" FontSize="23" FontWeight="SemiBold" Foreground="White" TextAlignment="Right" Margin="0,0,0,5"/>
<TextBlock Text="سامانه مدیریت سود ماهانه" Foreground="#CBD5E1" TextAlignment="Right"/>
</StackPanel>
<Border Grid.Column="0" Background="White" CornerRadius="9" Padding="8,5" VerticalAlignment="Center">
<WrapPanel FlowDirection="RightToLeft">
<Border Background="#ECFDF3" CornerRadius="6" Padding="7,4" Margin="0,0,5,0">
<TextBlock x:Name="ClosedBadge" Text="ماه باز" Foreground="#157347" VerticalAlignment="Center"/>
</Border>
<ComboBox x:Name="Months" Width="112" SelectionChanged="MonthChanged" Margin="0,0,5,0"/>
<Button Content="+ ماه جدید" Click="NewMonth" Style="{StaticResource Primary}" Margin="0,0,5,0"/>
<Button Content="⋯" Click="OpenMonthMenu" Width="34" FontSize="18" FontWeight="SemiBold" Padding="0,0,0,4" ToolTip="عملیات ماه">
<Button.ContextMenu>
<ContextMenu FlowDirection="RightToLeft">
<MenuItem Header="کپی از ماه فعال" Click="CloneMonth"/>
<MenuItem Header="ویرایش نام ماه" Click="EditMonth"/>
<MenuItem Header="بستن / باز کردن ماه" Click="ToggleMonthClosed"/>
<Separator/>
<MenuItem Header="حذف ماه" Click="DeleteMonth" Foreground="#B42318"/>
</ContextMenu>
</Button.ContextMenu>
</Button>
</WrapPanel>
</Border>
</Grid>
</Border>
<TabControl Grid.Row="1" TabStripPlacement="Right" Margin="0,18,0,6">
<TabItem Header="داشبورد">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="22">
<StackPanel Margin="6,0,6,14">
<TextBlock Text="نمای کلی ماه" Style="{StaticResource PageTitle}"/>
<TextBlock Text="مهم‌ترین شاخص‌های مالی ماه انتخاب‌شده" Style="{StaticResource MutedText}"/>
</StackPanel>
<UniformGrid Columns="3">
<Border Style="{StaticResource MetricCard}">
<StackPanel>
<TextBlock Text="فروش کل" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="Sales" FontSize="27" FontWeight="SemiBold" Foreground="#172033" Margin="0,13,0,5"/>
<TextBlock Text="فروش نقدی و چکی" Style="{StaticResource MutedText}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource MetricCard}">
<StackPanel>
<TextBlock Text="سود پیش از هزینه ثابت" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="Profit" FontSize="27" FontWeight="SemiBold" Foreground="#172033" Margin="0,13,0,5"/>
<TextBlock x:Name="MarginLabel" Style="{StaticResource MutedText}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource MetricCard}">
<StackPanel>
<TextBlock Text="نتیجه پس از هزینه ثابت" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="Net" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,5"/>
<TextBlock x:Name="NetLabel" Style="{StaticResource MutedText}"/>
</StackPanel>
</Border>
</UniformGrid>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="ترکیب عملکرد" Style="{StaticResource CardTitle}"/>
<TextBlock x:Name="Breakdown" Foreground="#172033" LineHeight="29" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel>
</Border>
<Border Grid.Column="1" Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="هزینه ثابت ماه" Style="{StaticResource CardTitle}"/>
<TextBox x:Name="Fixed" Margin="0,11,0,5"/>
<WrapPanel FlowDirection="RightToLeft">
<Button Content="ثبت هزینه" Click="SaveFixed" Style="{StaticResource Primary}"/>
<Button Content="ریز هزینه‌ها" Click="FixedExpenses"/>
</WrapPanel>
</StackPanel>
</Border>
</Grid>
<Border Style="{StaticResource Panel}">
<StackPanel>
<Grid FlowDirection="RightToLeft">
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
<TextBlock Text="سودآوری برندها" Style="{StaticResource CardTitle}" TextAlignment="Right"/>
<TextBlock Text="رتبه‌بندی بر اساس سود ناخالص" Style="{StaticResource MutedText}" TextAlignment="Right"/>
</StackPanel>
</Grid>
<DataGrid x:Name="BrandsGrid" MaxHeight="360" HorizontalAlignment="Right">
<DataGrid.Columns>
<DataGridTextColumn Header="رتبه" Binding="{Binding Rank}" Width="56"/>
<DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="190"/>
<DataGridTextColumn Header="تعداد کالا" Binding="{Binding Count}" Width="92"/>
<DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="180"/>
<DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="180"/>
<DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="110"/>
</DataGrid.Columns>
</DataGrid>
</StackPanel>
</Border>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="کالاها و فروش">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}">
<StackPanel>
<StackPanel>
<TextBlock Text="کالاهای ماه جاری" Style="{StaticResource PageTitle}"/>
<TextBlock x:Name="ProductCount" Style="{StaticResource MutedText}"/>
</StackPanel>
<Grid Margin="0,12,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right">
<TextBox x:Name="ProductSearch" Width="240" Margin="4" ToolTip="جست‌وجوی نام کالا یا برند" TextChanged="ProductFilterChanged"/>
<ComboBox x:Name="BrandFilter" Width="160" SelectionChanged="ProductFilterChanged"/>
<Button Content="پاک کردن جست‌وجو" Click="ClearProductFilter"/>
</WrapPanel>
<WrapPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Left">
<Button Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}"/>
<Button Content="ویرایش" Click="EditProduct"/>
<Button Content="حذف" Click="DeleteProduct"/>
<Button Content="بازگردانی حذف" Click="UndoDelete"/>
</WrapPanel>
</Grid>
</StackPanel>
</Border>
<Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="13">
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right">
<Button Content="ورود از اکسل" Click="ImportExcel"/>
<Button Content="خروجی ماه فعال" Click="ExportExcel" Style="{StaticResource Primary}"/>
</WrapPanel>
</Border>
<Grid>
<DataGrid x:Name="ItemsGrid" MouseDoubleClick="EditProduct">
<DataGrid.Columns>
<DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="130"/>
<DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="170"/>
<DataGridTextColumn Header="قیمت خرید واحد" Binding="{Binding PriceText}" Width="140"/>
<DataGridTextColumn Header="مقدار" Binding="{Binding QuantityText}" Width="80"/>
<DataGridTextColumn Header="بهای تمام‌شده" Binding="{Binding CostText}" Width="140"/>
<DataGridTextColumn Header="فروش کل" Binding="{Binding SalesText}" Width="140"/>
<DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="140"/>
<DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="100"/>
</DataGrid.Columns>
</DataGrid>
<Border x:Name="ItemsEmpty" Visibility="Collapsed" Background="White">
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
<TextBlock Text="هنوز کالایی برای نمایش نیست" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
<TextBlock Text="برای شروع، اولین کالا را در همین ماه ثبت کنید." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"/>
<Button Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}"/>
</StackPanel>
</Border>
</Grid>
</DockPanel>
</TabItem>
<TabItem Header="گزارش‌ها">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="22">
<Border Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft">
<Grid HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
<StackPanel HorizontalAlignment="Right">
<TextBlock Text="گزارش ماه‌ها" Style="{StaticResource PageTitle}" TextAlignment="Right" HorizontalAlignment="Right"/>
<TextBlock Text="مقایسه عملکرد، فیلتر بازه و روند مالی" Style="{StaticResource MutedText}" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,4,0,0"/>
</StackPanel>
</Grid>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,14,0,0">
<TextBlock Text="آمار بازه ماه:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="5"/>
<TextBlock Text="از" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5"/>
<ComboBox x:Name="HistoryFrom" Width="110" SelectionChanged="HistoryFilterChanged"/>
<TextBlock Text="تا" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5"/>
<ComboBox x:Name="HistoryTo" Width="110" SelectionChanged="HistoryFilterChanged"/>
<Button Content="پاک کردن فیلتر" Click="ClearHistoryFilter"/>
<Border Width="1" Height="30" Background="#E4E8EF" Margin="9,0" VerticalAlignment="Center"/>
<Button Content="چاپ ماه فعال" Click="PrintReport"/>
<Button Content="خروجی ماه فعال" Click="ExportExcel"/>
<Button Content="خروجی بازه" Click="ExportRange" Style="{StaticResource Primary}"/>
</WrapPanel>
</StackPanel>
</Border>
<Grid Margin="6">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="فروش بازه" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="RangeSales" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
</StackPanel>
</Border>
<Border Grid.Column="1" Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="سود ناخالص بازه" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="RangeProfit" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
</StackPanel>
</Border>
<Border Grid.Column="2" Style="{StaticResource Panel}">
<StackPanel>
<TextBlock x:Name="RangeOutcome" Text="نتیجه نهایی" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="RangeNet" FontSize="20" FontWeight="SemiBold"/>
</StackPanel>
</Border>
</Grid>
<Border Style="{StaticResource Panel}">
<StackPanel>
<TextBlock x:Name="HistorySummary" Visibility="Collapsed" Text="همه ماه‌های ثبت‌شده" TextWrapping="Wrap"/>
<Grid Height="270">
<Canvas x:Name="TrendCanvas" SizeChanged="TrendSizeChanged" Background="#FAFBFD" Margin="0,0,0,8" ClipToBounds="True"/>
<TextBlock x:Name="TrendEmpty" Visibility="Collapsed" Text="برای نمایش روند حداقل دو ماه لازم است." HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Grid>
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="0,1,0,0" Padding="8,9" Margin="0,4,0,0">
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right">
<TextBlock Text="نمایش در نمودار:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
<CheckBox x:Name="TrendSales" Content="فروش کل" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged" VerticalAlignment="Center" Margin="8,0"/>
<CheckBox x:Name="TrendProfit" Content="سود ناخالص" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged" VerticalAlignment="Center" Margin="8,0"/>
<CheckBox x:Name="TrendNet" Content="نتیجه نهایی" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged" VerticalAlignment="Center" Margin="8,0"/>
</WrapPanel>
</Border>
</StackPanel>
</Border>
<DataGrid x:Name="HistoryGrid" Margin="6">
<DataGrid.Columns>
<DataGridTextColumn Header="ماه" Binding="{Binding Key}" Width="90"/>
<DataGridTextColumn Header="بهای تمام‌شده" Binding="{Binding CostText}" Width="145"/>
<DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="145"/>
<DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="145"/>
<DataGridTextColumn Header="هزینه ثابت" Binding="{Binding FixedText}" Width="145"/>
<DataGridTextColumn Header="وضعیت" Binding="{Binding OutcomeText}" Width="90"/>
<DataGridTextColumn Header="نتیجه ماه" Binding="{Binding NetText}" Width="145"/>
</DataGrid.Columns>
</DataGrid>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="پشتیبان و راهنما">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="22">
<Border Style="{StaticResource Panel}" HorizontalAlignment="Stretch">
<StackPanel>
<Grid HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
<StackPanel HorizontalAlignment="Right">
<TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource PageTitle}" TextAlignment="Right" HorizontalAlignment="Right"/>
<TextBlock Text="مدیریت نسخه‌های امن اطلاعات این رایانه" Style="{StaticResource MutedText}" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,4,0,0"/>
</StackPanel>
</Grid>
<UniformGrid Columns="2" Margin="0,16,0,0">
<Border Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
<StackPanel>
<Grid FlowDirection="RightToLeft">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<StackPanel>
<TextBlock Text="پشتیبان خودکار" Style="{StaticResource CardTitle}"/>
<TextBlock x:Name="AutoBackupState" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel>
<Border x:Name="AutoBackupBadge" Grid.Column="1" Background="#EEF2F6" CornerRadius="12" Padding="9,4" Margin="8,0,0,0" VerticalAlignment="Top">
<TextBlock x:Name="AutoBackupBadgeText" FontWeight="SemiBold" Foreground="#475467"/>
</Border>
</Grid>
<TextBlock x:Name="LastAutoBackup" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
<CheckBox x:Name="AutoBackup" Content="فعال‌سازی پشتیبان خودکار هنگام خروج" Checked="AutoBackupChanged" Unchecked="AutoBackupChanged" Margin="0,13,0,0"/>
<TextBlock Text="۸ نسخهٔ خودکار آخر نگه‌داری می‌شود." Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
</StackPanel>
</Border>
<Border Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
<StackPanel>
<Grid FlowDirection="RightToLeft">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<StackPanel>
<TextBlock Text="پشتیبان دستی و بازیابی" Style="{StaticResource CardTitle}"/>
<TextBlock Text="ذخیره یا بازیابی نسخهٔ اطلاعات در زمان دلخواه" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel>
<Border x:Name="ManualBackupBadge" Grid.Column="1" Background="#EEF2F6" CornerRadius="12" Padding="9,4" Margin="8,0,0,0" VerticalAlignment="Top">
<TextBlock x:Name="ManualBackupBadgeText" FontWeight="SemiBold" Foreground="#475467"/>
</Border>
</Grid>
<TextBlock x:Name="LastManualBackup" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8"/>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,14,6,4">
<Button Content="ذخیره نسخه پشتیبان" Click="Backup" Style="{StaticResource Primary}"/>
<Button Content="بازیابی پشتیبان" Click="Restore"/>
<Button Content="بازکردن پوشه اطلاعات" Click="OpenDataFolder"/>
<Button Content="بازکردن پشتیبان‌ها" Click="OpenBackupFolder"/>
</WrapPanel>
</StackPanel>
</Border>
</UniformGrid>
</StackPanel>
</Border>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="درباره">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="22">
<Border Style="{StaticResource Panel}" HorizontalAlignment="Stretch" Padding="28">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="150"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#F6F1FF" CornerRadius="16" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Center">
<Image Source="pack://application:,,,/Assets/webilo-logo.png" Width="112" Height="112" Stretch="Uniform"/>
</Border>
<StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft">
<TextBlock Text="وبـیـــلـو" FontSize="30" FontWeight="Bold" Foreground="#6D28D9" TextAlignment="Right"/>
<TextBlock Text="طراحی و توسعهٔ راهکارهای نرم‌افزاری کسب‌وکار" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextAlignment="Right" Margin="0,6,0,0"/>
<TextBlock Text="توسعه‌دهنده: Sadegh Malekzadeh" Style="{StaticResource MutedText}" TextAlignment="Right" Margin="0,8,0,0"/>
</StackPanel>
</Grid>
</Border>
<Border Style="{StaticResource Panel}" HorizontalAlignment="Stretch">
<StackPanel>
<Grid HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
<StackPanel HorizontalAlignment="Right">
<TextBlock Text="سامانه مدیریت سود ماهانه" Style="{StaticResource PageTitle}" TextAlignment="Right" HorizontalAlignment="Right"/>
<TextBlock Text="راهکاری محلی برای ثبت خرید، فروش، هزینه‌های ثابت و مشاهدهٔ سود ماهانهٔ شرکت متحد توزیع ایرانیان." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,7,0,0"/>
</StackPanel>
</Grid>
<UniformGrid Columns="3" Margin="0,18,0,0">
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,5,0">
<StackPanel>
<TextBlock Text="سازمان" Style="{StaticResource MutedText}"/>
<TextBlock Text="شرکت متحد توزیع ایرانیان" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel>
</Border>
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5,0">
<StackPanel>
<TextBlock Text="حریم داده‌ها" Style="{StaticResource MutedText}"/>
<TextBlock Text="داده‌ها فقط روی همین رایانه ذخیره می‌شوند" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel>
</Border>
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5,0,0,0">
<StackPanel>
<TextBlock Text="اطلاعات نسخه" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="AboutVersion" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel>
</Border>
</UniformGrid>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button Content="کپی اطلاعات نسخه" Click="CopyVersion"/>
</WrapPanel>
</StackPanel>
</Border>
<Border Background="#F6F1FF" BorderBrush="#E6D9FF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="6">
<TextBlock Text="Powered by Webilo · Sadegh Malekzadeh" Foreground="#6D28D9" FontWeight="SemiBold" TextAlignment="Center"/>
</Border>
</StackPanel>
</ScrollViewer>
</TabItem>
</TabControl>
<Border Grid.Row="2" Background="Transparent" Padding="8,5">
<TextBlock x:Name="Status" Text="آماده" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
</Border>
</Grid>
</Window>
