</StackPanel></Border>
<DataGrid x:Name="SalesGrid" MouseDoubleClick="SalesGrid_MouseDoubleClick"><DataGrid.Columns>
<DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="0.75*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" Width="1.35*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="0.85*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width=".9*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="1.55*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width=".6*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="پس از کسورات" Binding="{Binding InvoiceNetText}" Width="1.15*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="تخفیف نقدی" Binding="{Binding CashDiscountText}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="دریافتی نهایی" Binding="{Binding SalesText}" Width="1.15*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="بهای FIFO" Binding="{Binding CostText}" Width="1.1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width=".85*" ElementStyle="{StaticResource TableText}"/>
</DataGrid.Columns></DataGrid>
</DockPanel>
</TabItem>
<TabItem Header="موجودی">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="موجودی پایان ماه انتخاب‌شده" Style="{StaticResource PageTitle}"/>
<TextBlock x:Name="InventorySummary" Style="{StaticResource MutedText}" Margin="0,5,0,12" TextWrapping="Wrap"/>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><Button Content="موجودی افتتاحیه از ۱۴۰۴" Click="ImportOpeningInventory"/><Button Content="نمایش مغایرت‌ها" Click="OpenReconciliations" Style="{StaticResource Primary}"/></WrapPanel>
</StackPanel></Border>
<DataGrid x:Name="InventoryGrid"><DataGrid.Columns>
<DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.1*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="1.9*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="موجودی ابتدای ماه" Binding="{Binding OpeningText}" Width="1*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="خرید ماه" Binding="{Binding PurchasedText}" Width=".9*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="فروش ماه" Binding="{Binding SoldText}" Width=".9*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="موجودی پایان ماه" Binding="{Binding ClosingText}" Width="1.1*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="ارزش موجودی" Binding="{Binding CostText}" Width="1.25*" ElementStyle="{StaticResource TableNumber}"/>
</DataGrid.Columns></DataGrid>
</DockPanel>
</TabItem>
<TabItem Header="مغایرت‌ها">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="مغایرت‌های موجودی" Style="{StaticResource PageTitle}"/><TextBlock x:Name="ReconciliationSummary" Style="{StaticResource MutedText}" Margin="0,5,0,12" TextWrapping="Wrap"/><WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="برای رسیدگی به هر کالا، روی ردیف آن دوبار کلیک کنید." Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBox x:Name="ReconciliationSearch" Style="{StaticResource SearchBox}" Width="260" ToolTip="جست‌وجو در کد، کالا یا برند" TextChanged="ReconciliationSearchChanged"/><Button Content="پاک‌کردن جست‌وجو" Click="ClearReconciliationSearch"/></WrapPanel></StackPanel></Border>
<DataGrid x:Name="ReconciliationsGrid" SelectionMode="Single" MouseDoubleClick="ReconciliationsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="اولین تاریخ کسری" Binding="{Binding FirstDate}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.1*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کسری" Binding="{Binding QuantityText}" Width="1*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="قیمت پیشنهادی" Binding="{Binding SuggestedText}" Width="1.3*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="ردیف فروش" Binding="{Binding SaleRows}" Width=".8*" ElementStyle="{StaticResource TableCenter}"/></DataGrid.Columns></DataGrid>
</DockPanel>
</TabItem>
<TabItem Header="کدهای ناشناخته">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="کدهای نیازمند تعیین برند" Style="{StaticResource PageTitle}"/><TextBlock x:Name="PendingBrandSummary" Style="{StaticResource MutedText}" Margin="0,5,0,12" TextWrapping="Wrap"/><WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="برای تعیین برند هر کالا، روی ردیف آن دوبار کلیک کنید." Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBox x:Name="PendingBrandSearch" Style="{StaticResource SearchBox}" Width="260" ToolTip="جست‌وجو در کد یا نام کالا" TextChanged="PendingBrandSearchChanged"/><Button Content="پاک‌کردن جست‌وجو" Click="ClearPendingBrandSearch"/><Button Content="+ افزودن برند" Click="AddBrand"/></WrapPanel></StackPanel></Border>
<DataGrid x:Name="PendingBrandsGrid" SelectionMode="Single" MouseDoubleClick="PendingBrandsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2.4*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="ردیف خرید" Binding="{Binding PurchaseRows}" Width=".9*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="ردیف فروش" Binding="{Binding SaleRows}" Width=".9*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="تعداد کل" Binding="{Binding QuantityText}" Width="1*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="اولین تاریخ" Binding="{Binding FirstDate}" Width="1*" ElementStyle="{StaticResource TableNumber}"/></DataGrid.Columns></DataGrid>
</DockPanel>
</TabItem>
<TabItem Header="برندها">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="تنظیمات برندها" Style="{StaticResource PageTitle}"/><TextBlock x:Name="BrandSummary" Style="{StaticResource MutedText}" Margin="0,5,0,12"/><WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><Button Content="+ افزودن برند" Click="AddBrand" Style="{StaticResource Primary}"/><TextBlock Text="برای ویرایش هر برند، روی ردیف آن دوبار کلیک کنید." Style="{StaticResource MutedText}" VerticalAlignment="Center"/></WrapPanel></StackPanel></Border>
<DataGrid x:Name="BrandSettingsGrid" MouseDoubleClick="BrandSettingsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="برند" Binding="{Binding Name}" Width="1.3*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="پیشوند کد" Binding="{Binding Prefixes}" Width="1*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="تخفیف خرید" Binding="{Binding PurchaseDiscountText}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="آفر" Binding="{Binding OfferText}" Width=".8*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="مارک‌آپ" Binding="{Binding MarkupText}" Width=".9*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="سهم نقدی" Binding="{Binding CashShareText}" Width=".9*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="سهم چکی" Binding="{Binding CreditShareText}" Width=".9*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="تخفیف نقدی" Binding="{Binding CashDiscountText}" Width="1*" ElementStyle="{StaticResource TableNumber}"/></DataGrid.Columns></DataGrid>
</DockPanel>
</TabItem>
<TabItem Header="گزارش‌ها">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
