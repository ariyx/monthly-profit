<Window x:Class="Profit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="شرکت متحد توزیع ایرانیان | مدیریت سود ماهانه" Width="1280" Height="860" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Vazir}" FlowDirection="LeftToRight">
