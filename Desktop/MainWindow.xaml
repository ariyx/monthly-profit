<Button Content="خروجی ماه فعال" Click="ExportExcel"/>
<Button Content="خروجی بازه" Click="ExportRange" Style="{StaticResource Primary}"/>
</WrapPanel>
</WrapPanel>
</DockPanel>
</StackPanel>
</Border>
<Grid Margin="6" FlowDirection="RightToLeft">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="فروش بازه" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
<TextBlock x:Name="RangeSales" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FlowDirection="LeftToRight" TextAlignment="Right"/>
</StackPanel>
</Border>
<Border Grid.Column="1" Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="سود ناخالص بازه" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
<TextBlock x:Name="RangeProfit" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FlowDirection="LeftToRight" TextAlignment="Right"/>
</StackPanel>
</Border>
<Border Grid.Column="2" Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock x:Name="RangeOutcome" Text="نتیجه نهایی" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
<TextBlock x:Name="RangeNet" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Right"/>
</StackPanel>
</Border>
</Grid>
<Border Style="{StaticResource Panel}">
<StackPanel>
