<TextBlock x:Name="MarginLabel" Style="{StaticResource MutedText}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource MetricCard}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="نتیجه پس از هزینه ثابت" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="Net" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,5" FlowDirection="LeftToRight" TextAlignment="Right"/>
<TextBlock x:Name="NetLabel" Style="{StaticResource MutedText}"/>
</StackPanel>
</Border>
</UniformGrid>
<Grid FlowDirection="RightToLeft">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="ترکیب عملکرد" Style="{StaticResource CardTitle}"/>
<TextBlock x:Name="Breakdown" Foreground="#172033" LineHeight="29" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel>
</Border>
<Border Grid.Column="1" Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="هزینه ثابت ماه" Style="{StaticResource CardTitle}"/>
<TextBox x:Name="Fixed" Margin="0,11,0,5"/>
<WrapPanel FlowDirection="RightToLeft">
<Button Content="ثبت هزینه" Click="SaveFixed" Style="{StaticResource Primary}"/>
<Button Content="ریز هزینه‌ها" Click="FixedExpenses"/>
</WrapPanel>
</StackPanel>
</Border>
</Grid>
<Border Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" FlowDirection="RightToLeft">
<TextBlock Text="سودآوری برندها" Style="{StaticResource CardTitle}"/>
<TextBlock Text="رتبه‌بندی بر اساس سود ناخالص" Style="{StaticResource MutedText}" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
<DataGrid x:Name="BrandsGrid" MaxHeight="360" HorizontalAlignment="Stretch" Margin="0,8,0,0">
<DataGrid.Columns>
<DataGridTextColumn Header="رتبه" Binding="{Binding Rank}" Width="0.55*" ElementStyle="{StaticResource TableCenter}"/>
<DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.45*" ElementStyle="{StaticResource TableText}"/>
<DataGridTextColumn Header="تعداد کالا" Binding="{Binding Count}" Width="0.85*" ElementStyle="{StaticResource TableCenter}"/>
<DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="1.35*" ElementStyle="{StaticResource TableNumber}"/>
<DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="1.35*" ElementStyle="{StaticResource TableNumber}"/>
