</StackPanel></Border>
<DataGrid x:Name="PurchasesGrid"><DataGrid.Columns>
<DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width=".7*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="0.8*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding Supplier}" Width="1.45*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="0.9*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="1.8*" ElementStyle="{StaticResource TableText}"/><DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width="0.65*" ElementStyle="{StaticResource TableCenter}"/><DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalText}" Width="1.15*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="کسورات" Binding="{Binding DeductionsText}" Width="1*" ElementStyle="{StaticResource TableNumber}"/><DataGridTextColumn Header="بهای خالص" Binding="{Binding NetText}" Width="1.2*" ElementStyle="{StaticResource TableNumber}"/>
</DataGrid.Columns></DataGrid>
</DockPanel>
</TabItem>
<TabItem Header="فروش‌ها">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="فروش‌های ماه انتخاب‌شده" Style="{StaticResource PageTitle}"/>
