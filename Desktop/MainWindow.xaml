<Window x:Class="Profit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="متحد توزیع ایرانیان | مدیریت سود ماهانه" Width="1280" Height="860" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#151A25" CornerRadius="16" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="2" Width="126" Height="72" Background="White" BorderBrush="#F3B5B5" BorderThickness="1" CornerRadius="9" Padding="6"><Image Source="pack://application:,,,/Assets/company-logo-cropped.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/></Border><StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="متحد توزیع ایرانیان" FontSize="23" FontWeight="SemiBold" Foreground="White" TextAlignment="Right"/><TextBlock Text="سامانه مدیریت سود ماهانه" Foreground="#CBD5E1" Margin="0,6,0,0" TextAlignment="Right"/></StackPanel><Border Grid.Column="0" Background="White" CornerRadius="9" Padding="7,3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="ماه فعال" Foreground="#475467" VerticalAlignment="Center" Margin="5,0"/><ComboBox x:Name="Months" Width="118" SelectionChanged="MonthChanged"/><Button Content="ماه جدید" Click="NewMonth"/><Button Content="کپی ماه" Click="CloneMonth"/></StackPanel></Border></Grid></Border>
  <TabControl Grid.Row="1" TabStripPlacement="Right" Margin="0,18,0,6">
   <TabItem Header="داشبورد"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><Grid Margin="6,0,6,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="نمای کلی ماه" Style="{StaticResource SectionTitle}"/><TextBlock Text="مهم‌ترین شاخص‌های مالی ماه انتخاب‌شده" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}" VerticalAlignment="Center"/></Grid><UniformGrid Columns="3"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="فروش کل" Style="{StaticResource MutedText}"/><TextBlock x:Name="Sales" FontSize="27" FontWeight="SemiBold" Foreground="#172033" Margin="0,13,0,5"/><TextBlock Text="فروش نقدی و چکی" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="سود پیش از هزینه ثابت" Style="{StaticResource MutedText}"/><TextBlock x:Name="Profit" FontSize="27" FontWeight="SemiBold" Foreground="#172033" Margin="0,13,0,5"/><TextBlock x:Name="MarginLabel" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="نتیجه پس از هزینه ثابت" Style="{StaticResource MutedText}"/><TextBlock x:Name="Net" FontSize="27" FontWeight="SemiBold" Foreground="#172033" Margin="0,13,0,5"/><TextBlock x:Name="NetLabel" Style="{StaticResource MutedText}"/></StackPanel></Border></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="ترکیب عملکرد" Style="{StaticResource SectionTitle}"/><Border Height="1" Background="#EDF0F4" Margin="0,14,0,12"/><TextBlock x:Name="Breakdown" Foreground="#172033" LineHeight="29" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="هزینه ثابت ماه" Style="{StaticResource SectionTitle}"/><TextBlock Text="مبلغ به ریال" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBox x:Name="Fixed" Margin="0,11,0,5"/><StackPanel Orientation="Horizontal"><Button Content="ثبت هزینه" Click="SaveFixed" Style="{StaticResource Primary}"/><TextBlock x:Name="FixedHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Width="190" VerticalAlignment="Center" Margin="8,0"/></StackPanel></StackPanel></Border></Grid><Border Style="{StaticResource Panel}"><StackPanel><StackPanel Margin="0,0,0,15" HorizontalAlignment="Right"><TextBlock Text="سودآوری برندها" Style="{StaticResource SectionTitle}" TextAlignment="Right"/><TextBlock Text="رتبه‌بندی بر اساس سود ناخالص" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextAlignment="Right"/></StackPanel><DataGrid x:Name="BrandsGrid" MaxHeight="360"><DataGrid.Columns><DataGridTextColumn Header="رتبه" Binding="{Binding Rank}" Width="0.65*" MinWidth="55"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.55*" MinWidth="120"/><DataGridTextColumn Header="تعداد کالا" Binding="{Binding Count}" Width="0.8*" MinWidth="75"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="1.25*" MinWidth="115"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="1.25*" MinWidth="115"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="1*" MinWidth="90"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="کالاها و فروش"><DockPanel Margin="22"><Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="کالاهای ماه جاری" Style="{StaticResource SectionTitle}"/><TextBlock Text="برای هر کالا، قیمت خرید و درصدهای فروش مستقل ثبت می‌شود." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Left"><Button Content="+ افزودن کالا" Click="AddProduct" Style="{StaticResource Primary}"/><Button Content="ویرایش" Click="EditProduct"/><Button Content="حذف" Click="DeleteProduct"/><Button Content="بازگردانی حذف" Click="UndoDelete"/></WrapPanel></Grid></Border><Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,14,0,0"><DockPanel><TextBlock Text="ورود یا خروجی فایل Excel" FontWeight="SemiBold" VerticalAlignment="Center"/><WrapPanel DockPanel.Dock="Left"><Button Content="ورود از اکسل" Click="ImportExcel"/><Button Content="خروجی اکسل" Click="ExportExcel" Style="{StaticResource Primary}"/></WrapPanel></DockPanel></Border><DataGrid x:Name="ItemsGrid" MouseDoubleClick="EditProduct"><DataGrid.Columns><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="0.95*" MinWidth="100"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="1.55*" MinWidth="135"/><DataGridTextColumn Header="قیمت خرید واحد" Binding="{Binding PriceText}" Width="1.1*" MinWidth="115"/><DataGridTextColumn Header="مقدار" Binding="{Binding QuantityText}" Width="0.7*" MinWidth="75"/><DataGridTextColumn Header="فروش کل" Binding="{Binding SalesText}" Width="1.05*" MinWidth="110"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="1.05*" MinWidth="110"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="1*" MinWidth="90"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="گزارش‌ها"><DockPanel Margin="22"><Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="گزارش ماه‌ها" Style="{StaticResource SectionTitle}"/><TextBlock Text="مقایسهٔ عملکرد تمام ماه‌های ثبت‌شده و تهیهٔ خروجی قابل ارسال" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Left"><Button Content="چاپ / ذخیره PDF" Click="PrintReport"/><Button Content="خروجی اکسل ماه فعال" Click="ExportExcel" Style="{StaticResource Primary}"/></WrapPanel></Grid></Border><Border DockPanel.Dock="Bottom" Background="#FFF8F8" BorderBrush="#F5C6C6" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,14,0,0"><TextBlock Text="حاشیه سود کل = مجموع سود ناخالص ÷ مجموع فروش. هزینه ثابت فقط یک‌بار در هر ماه کسر می‌شود." TextWrapping="Wrap" Foreground="#8F2020"/></Border><DataGrid x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="ماه" Binding="{Binding Key}" Width="90"/><DataGridTextColumn Header="خرید" Binding="{Binding CostText}" Width="*"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="*"/><DataGridTextColumn Header="سود ناخالص" Binding="{Binding ProfitText}" Width="*"/><DataGridTextColumn Header="هزینه ثابت" Binding="{Binding FixedText}" Width="*"/><DataGridTextColumn Header="نتیجه ماه" Binding="{Binding NetText}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="پشتیبان و راهنما"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="مدیریت اطلاعات" Style="{StaticResource SectionTitle}" Margin="6,0,6,8"/><TextBlock Text="اطلاعات فقط روی همین رایانه ذخیره می‌شود. برای انتقال یا اطمینان از حفظ داده‌ها، نسخهٔ پشتیبان تهیه کنید." Style="{StaticResource MutedText}" Margin="6,0,6,10" TextWrapping="Wrap"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource SectionTitle}"/><TextBlock Text="نسخهٔ پشتیبان شامل تمام ماه‌ها و کالاهای ثبت‌شده است." Style="{StaticResource MutedText}" Margin="0,6,0,12"/><WrapPanel><Button Content="ذخیره نسخه پشتیبان" Click="Backup" Style="{StaticResource Primary}"/><Button Content="بازیابی پشتیبان" Click="Restore"/><Button Content="بازکردن پوشه اطلاعات" Click="OpenDataFolder"/></WrapPanel><Border Background="#FFF8F8" BorderBrush="#F5C6C6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0"><TextBlock Text="بازیابی، داده‌های فعلی را جایگزین می‌کند؛ برنامه قبل از آن یک نسخهٔ ایمنی ذخیره می‌کند." Foreground="#8F2020" TextWrapping="Wrap"/></Border></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="قواعد محاسبات" Style="{StaticResource SectionTitle}"/><TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="29" Text="• تخفیف خرید و آفر هر دو از مبلغ اولیه خرید محاسبه می‌شوند.&#10;• سود اضافه روی قیمت خرید واحد اولیه اعمال می‌شود.&#10;• تمام مقدار خرید فروخته می‌شود؛ سهم نقدی و چکی در مجموع ۱۰۰٪ است.&#10;• تخفیف نقدی فقط از بخش نقدی فروش کسر می‌شود؛ مدت چک هزینه‌ای ندارد.&#10;• سود ناخالص برابر فروش منهای بهای خرید است؛ هزینه ثابت ماه فقط یک‌بار کم می‌شود.&#10;• تعداد هر کالا می‌تواند اعشاری باشد؛ جمع مقدار کالاهای با واحد متفاوت شاخص مالی نیست."/></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="داده آزمایشی" Style="{StaticResource SectionTitle}"/><TextBlock Text="برای آشنایی با برنامه، شش ردیف نمونه را فقط به ماه خالی اضافه کنید." Style="{StaticResource MutedText}" Margin="0,6,0,10"/><Button Content="افزودن نمونه اکسل بررسی‌شده به ماه خالی" Click="LoadSample" HorizontalAlignment="Right"/><TextBlock x:Name="VersionLabel" Text="نسخه اولیه ۰٫۱ · قواعد محاسبات ۱ · ویندوز ۶۴ بیتی" Style="{StaticResource MutedText}" Margin="0,18,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="Transparent" Padding="8,5"><TextBlock x:Name="Status" Text="آماده" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></Border>
 </Grid>
</Window>
