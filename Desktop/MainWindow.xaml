<Grid Margin="22" HorizontalAlignment="Stretch"><StackPanel HorizontalAlignment="Stretch">
<Border Style="{StaticResource Panel}" HorizontalAlignment="Stretch">
<StackPanel>
<StackPanel HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
<TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource PageTitle}"/>
<TextBlock Text="مدیریت نسخه‌های امن اطلاعات این رایانه" Style="{StaticResource MutedText}" TextAlignment="Right" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
</StackPanel>
<UniformGrid Columns="2" Margin="0,16,0,0" FlowDirection="RightToLeft">
<Border Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
<StackPanel>
<StackPanel FlowDirection="RightToLeft">
<StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Top">
<Border x:Name="AutoBackupBadge" Background="#EEF2F6" CornerRadius="12" Padding="9,4" Margin="0,0,9,0" VerticalAlignment="Top">
<TextBlock x:Name="AutoBackupBadgeText" FontWeight="SemiBold" Foreground="#475467"/>
</Border>
<TextBlock Text="پشتیبان خودکار" Style="{StaticResource CardTitle}" FlowDirection="RightToLeft" TextAlignment="Right" VerticalAlignment="Center"/>
</StackPanel>
<TextBlock x:Name="AutoBackupState" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
<TextBlock x:Name="LastAutoBackup" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
<CheckBox x:Name="AutoBackup" Content="فعال‌سازی پشتیبان خودکار هنگام خروج" Checked="AutoBackupChanged" Unchecked="AutoBackupChanged" Margin="0,13,0,0"/>
<TextBlock Text="۸ نسخهٔ خودکار آخر نگه‌داری می‌شود." Style="{StaticResource MutedText}" Margin="0,5,0,0" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
</Border>
<Border Background="#F8FAFC" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
<StackPanel>
<StackPanel FlowDirection="RightToLeft">
<StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Top">
<Border x:Name="ManualBackupBadge" Background="#EEF2F6" CornerRadius="12" Padding="9,4" Margin="0,0,9,0" VerticalAlignment="Top">
<TextBlock x:Name="ManualBackupBadgeText" FontWeight="SemiBold" Foreground="#475467"/>
</Border>
<TextBlock Text="پشتیبان دستی و بازیابی" Style="{StaticResource CardTitle}" FlowDirection="RightToLeft" TextAlignment="Right" VerticalAlignment="Center"/>
</StackPanel>
<TextBlock Text="ذخیره یا بازیابی نسخهٔ اطلاعات در زمان دلخواه" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
<TextBlock x:Name="LastManualBackup" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,14,6,4">
<Button Content="ذخیره نسخه پشتیبان" Click="Backup" Style="{StaticResource Primary}"/>
<Button Content="بازیابی پشتیبان" Click="Restore"/>
<Button Content="بازکردن پشتیبان‌ها" Click="OpenBackupFolder"/>
</WrapPanel>
</StackPanel>
</Border>
</UniformGrid>
</StackPanel>
</Border>
</StackPanel>
</Grid>
</ScrollViewer>
</TabItem>
<TabItem Header="درباره">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
<Grid Margin="22" HorizontalAlignment="Stretch"><StackPanel HorizontalAlignment="Stretch">
<Border Style="{StaticResource Panel}" HorizontalAlignment="Stretch" Padding="30" MinHeight="174">
<DockPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch" VerticalAlignment="Center">
<Grid DockPanel.Dock="Right" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Center">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="160"/>
</Grid.ColumnDefinitions>
<StackPanel Grid.Column="1" Margin="0,0,32,0" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft">
<TextBlock Text="وبـیـــلـو" FontSize="30" FontWeight="Bold" Foreground="#6D28D9" TextAlignment="Right" HorizontalAlignment="Stretch" FlowDirection="RightToLeft"/>
<TextBlock Text="طراحی و توسعهٔ راهکارهای نرم‌افزاری کسب‌وکار" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextAlignment="Right" HorizontalAlignment="Stretch" FlowDirection="RightToLeft" Margin="0,7,0,0"/>
<TextBlock Text="توسعه‌دهنده: Sadegh Malekzadeh" Style="{StaticResource MutedText}" TextAlignment="Right" HorizontalAlignment="Stretch" FlowDirection="RightToLeft" Margin="0,9,0,0"/>
</StackPanel>
<Border Grid.Column="0" Width="136" Height="136" Background="#F6F1FF" CornerRadius="18" Padding="14" HorizontalAlignment="Right" VerticalAlignment="Center">
<Image Source="pack://application:,,,/Assets/webilo-logo.png" Width="100" Height="100" Stretch="Uniform"/>
</Border>
</Grid>
</DockPanel>
</Border>
<Border Style="{StaticResource Panel}" HorizontalAlignment="Stretch">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="سامانه مدیریت سود ماهانه" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
<TextBlock Text="راهکاری محلی برای ثبت خرید، فروش، هزینه‌های ثابت و مشاهدهٔ سود ماهانهٔ شرکت متحد توزیع ایرانیان." Style="{StaticResource MutedText}" FlowDirection="RightToLeft" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Stretch" Margin="0,7,0,0"/>
<UniformGrid Columns="3" Margin="0,18,0,0" FlowDirection="RightToLeft">
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,5,0">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="سازمان" Style="{StaticResource MutedText}"/>
<TextBlock Text="شرکت متحد توزیع ایرانیان" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,6,0,0" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
</Border>
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5,0">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="حریم داده‌ها" Style="{StaticResource MutedText}"/>
<TextBlock Text="داده‌ها فقط روی همین رایانه ذخیره می‌شوند" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,6,0,0" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
</Border>
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5,0,0,0">
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
<TextBlock Text="اطلاعات نسخه" Style="{StaticResource MutedText}"/>
<TextBlock x:Name="AboutVersion" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,6,0,0" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/>
</StackPanel>
</Border>
</UniformGrid>
<WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button Content="کپی اطلاعات نسخه" Click="CopyVersion"/>
</WrapPanel>
</StackPanel>
</Border>
<Border Background="#F6F1FF" BorderBrush="#E6D9FF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="6">
<TextBlock Text="Powered by Webilo · Sadegh Malekzadeh" Foreground="#6D28D9" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Center" HorizontalAlignment="Stretch"/>
</Border>
</StackPanel>
</Grid>
</ScrollViewer>
</TabItem>
</TabControl>
<Border Grid.Row="2" Background="Transparent" Padding="8,5">
<TextBlock x:Name="Status" Text="آماده" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
</Border>
</Grid>
</Window>
