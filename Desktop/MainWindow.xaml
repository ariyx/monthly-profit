<Window x:Class="Profit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="شرکت متحد توزیع ایرانیان | مدیریت سود ماهانه" Width="1280" Height="860" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
<Grid Background="#F5F7FB">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#151A25" CornerRadius="0,0,16,16" Margin="20,0,20,12" Padding="16">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
<Button Content="⋯" Click="OpenMonthMenu" Padding="12,7"/><ComboBox x:Name="Months" Width="126" SelectionChanged="MonthChanged"/><TextBlock x:Name="ClosedBadge" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#B5F0D5"/>
</StackPanel>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="شرکت متحد توزیع ایرانیان" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="سامانه مدیریت سود فروش" Foreground="#C3D5F6" FontSize="12"/></StackPanel>
<Border Grid.Column="2" Background="White" CornerRadius="9" Padding="8" Margin="8,0,0,0"><Image Source="Assets/company-logo-cropped.png" Height="54" Stretch="Uniform"/></Border>
</Grid>
</Border>
<Grid Grid.Row="1" Margin="20,0,20,8">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="195"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}" Padding="0">
<Grid>
<Grid x:Name="DashboardPage" Margin="20">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel>
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="نمای کلی ماه" Style="{StaticResource PageTitle}"/><TextBlock Text="شاخص‌های مالی فروش‌های ماه انتخاب‌شده" Style="{StaticResource MutedText}" Margin="0,4,0,14"/></StackPanel>
<UniformGrid Columns="3" Margin="0,0,0,6">
<Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="فروش واقعی" Style="{StaticResource MutedText}"/><TextBlock x:Name="Sales" FontSize="27" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel></Border>
<Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="سود خالص فروش" Style="{StaticResource MutedText}"/><TextBlock x:Name="Profit" FontSize="27" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel></Border>
<Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="نتیجه پس از هزینه ثابت" Style="{StaticResource MutedText}"/><TextBlock x:Name="Net" FontSize="27" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right"/><TextBlock x:Name="NetLabel" Style="{StaticResource MutedText}"/></StackPanel></Border>
</UniformGrid>
<Grid Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="هزینه ثابت ماه" Style="{StaticResource CardTitle}"/><TextBox x:Name="Fixed" FlowDirection="LeftToRight" TextAlignment="Left"/><WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><Button Content="ثبت هزینه" Click="SaveFixed" Style="{StaticResource Primary}"/><Button Content="ریز هزینه‌ها" Click="FixedExpenses"/></WrapPanel></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="ترکیب عملکرد" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Breakdown" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
</Grid>
<Border Style="{StaticResource Panel}"><StackPanel><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="سودآوری برندها" Style="{StaticResource CardTitle}"/><TextBlock Text="رتبه‌بندی بر اساس سود خالص فروش" Style="{StaticResource MutedText}"/></StackPanel><DataGrid x:Name="BrandsGrid" Height="210" Margin="0,12,0,0" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="رتبه" Binding="{Binding Rank}" Width=".55*"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1.5*"/><DataGridTextColumn Header="تعداد کالا" Binding="{Binding Count}" Width="1*"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="1.5*"/><DataGridTextColumn Header="سود خالص فروش" Binding="{Binding ProfitText}" Width="1.5*"/><DataGridTextColumn Header="حاشیه سود" Binding="{Binding MarginText}" Width="1*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
</StackPanel>
</ScrollViewer>
</Grid>
<Grid x:Name="SalesPage" Margin="20" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="فروش‌ها" Style="{StaticResource PageTitle}"/><TextBlock x:Name="SalesSummary" Style="{StaticResource MutedText}" Margin="0,4,0,12"/></StackPanel>
<WrapPanel Grid.Row="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Button Content="+ ثبت فروش" Click="AddSale" Style="{StaticResource Primary}"/><Button Content="ورود فروش از اکسل" Click="ImportSales"/><TextBox x:Name="SalesSearch" Width="260" Style="{StaticResource SearchBox}" ToolTip="جست‌وجو در کد، کالا یا مشتری" TextChanged="SalesSearchChanged"/><Button Content="پاک‌کردن جست‌وجو" Click="ClearSalesSearch"/></WrapPanel>
<DataGrid Grid.Row="2" x:Name="SalesGrid" Margin="0,14,0,0" MouseDoubleClick="SalesGrid_MouseDoubleClick" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width=".85*"/><DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" Width="1.45*"/><DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="1*"/><DataGridTextColumn Header="برند" Binding="{Binding Brand}" Width="1*"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width=".75*"/><DataGridTextColumn Header="فروش واقعی" Binding="{Binding SalesText}" Width="1.25*"/><DataGridTextColumn Header="هزینه تخمینی" Binding="{Binding CostText}" Width="1.25*"/><DataGridTextColumn Header="سود فروش" Binding="{Binding ProfitText}" Width="1.25*"/><DataGridTextColumn Header="روش هزینه" Binding="{Binding CostMethod}" Width=".9*"/></DataGrid.Columns></DataGrid>
</Grid>
<Grid x:Name="BrandsPage" Margin="20" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="تنظیمات ماهانه برندها" Style="{StaticResource PageTitle}"/><TextBlock x:Name="BrandSummary" Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/></StackPanel>
<WrapPanel Grid.Row="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Button Content="تأیید / بازبینی تنظیمات این ماه" Click="ConfirmBrandMonth" Style="{StaticResource Primary}"/><Button Content="+ افزودن برند" Click="AddBrand"/></WrapPanel>
<DataGrid Grid.Row="2" x:Name="BrandSettingsGrid" Margin="0,14,0,0" MouseDoubleClick="BrandSettingsGrid_MouseDoubleClick" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="برند" Binding="{Binding Name}" Width="1.3*"/><DataGridTextColumn Header="پیشوند کد" Binding="{Binding Prefixes}" Width="1*"/><DataGridTextColumn Header="تخفیف خرید" Binding="{Binding PurchaseDiscountText}" Width="1*"/><DataGridTextColumn Header="آفر" Binding="{Binding OfferText}" Width=".8*"/><DataGridTextColumn Header="مارک‌آپ" Binding="{Binding MarkupText}" Width=".9*"/><DataGridTextColumn Header="سهم نقدی" Binding="{Binding CashShareText}" Width=".9*"/><DataGridTextColumn Header="سهم چکی" Binding="{Binding CreditShareText}" Width=".9*"/><DataGridTextColumn Header="تخفیف نقدی" Binding="{Binding CashDiscountText}" Width="1*"/></DataGrid.Columns></DataGrid>
</Grid>
<Grid x:Name="UnknownPage" Margin="20" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="کدهای ناشناخته" Style="{StaticResource PageTitle}"/><TextBlock x:Name="UnknownSummary" Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/></StackPanel>
<DataGrid Grid.Row="1" x:Name="UnknownGrid" MouseDoubleClick="UnknownGrid_MouseDoubleClick" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="1.1*"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2.5*"/><DataGridTextColumn Header="تعداد فروش معلق" Binding="{Binding PendingCount}" Width="1.2*"/><DataGridTextColumn Header="مبلغ فروش معلق" Binding="{Binding PendingSalesText}" Width="1.5*"/><DataGridTextColumn Header="اقدام" Binding="{Binding Action}" Width="1.6*"/></DataGrid.Columns></DataGrid>
</Grid>
<Grid x:Name="ReportsPage" Margin="20" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="گزارش ماه‌ها" Style="{StaticResource PageTitle}"/><TextBlock Text="مقایسه عملکرد فروش و نتیجه مالی" Style="{StaticResource MutedText}" Margin="0,4,0,12"/></StackPanel>
<WrapPanel Grid.Row="1" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="بازه گزارش:" VerticalAlignment="Center"/><ComboBox x:Name="HistoryFrom" SelectionChanged="HistoryFilterChanged"/><TextBlock Text="تا" VerticalAlignment="Center"/><ComboBox x:Name="HistoryTo" SelectionChanged="HistoryFilterChanged"/><Button Content="پاک‌کردن فیلتر" Click="ClearHistoryFilter"/><Button Content="پرینت" ToolTip="باز کردن پنجره چاپ گزارش ماه فعال" Click="PrintReport" Style="{StaticResource Primary}"/><Button Content="خروجی اکسل ماه فعال" ToolTip="ذخیره جزئیات فروش و سود ماه انتخاب‌شده در اکسل" Click="ExportExcel"/><Button Content="خروجی اکسل بازه" ToolTip="ذخیره خلاصه ماه‌های بازه انتخاب‌شده در اکسل" Click="ExportRange"/></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="فروش بازه" Style="{StaticResource MutedText}"/><TextBlock x:Name="RangeSales" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="سود خالص فروش بازه" Style="{StaticResource MutedText}"/><TextBlock x:Name="RangeProfit" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource MetricCard}"><StackPanel><TextBlock x:Name="RangeOutcome" Style="{StaticResource MutedText}"/><TextBlock x:Name="RangeNet" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel></Border></Grid>
<Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="270"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}"><Grid><Canvas x:Name="TrendCanvas" Background="#FAFBFD" SizeChanged="TrendSizeChanged"/><TextBlock x:Name="TrendEmpty" Text="برای نمایش روند حداقل دو ماه لازم است." HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><Border Grid.Row="1" Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="0,1,0,0" Padding="10" Margin="6,0"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="نمایش در نمودار:" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="TrendNet" Content="نتیجه نهایی" Style="{StaticResource TrendCheckBox}" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged"/><CheckBox x:Name="TrendProfit" Content="سود خالص فروش" Style="{StaticResource TrendCheckBox}" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged"/><CheckBox x:Name="TrendSales" Content="فروش کل" Style="{StaticResource TrendCheckBox}" IsChecked="True" Checked="TrendFilterChanged" Unchecked="TrendFilterChanged"/></StackPanel></Border><DataGrid Grid.Row="2" x:Name="HistoryGrid" Margin="6,12,6,0" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ماه" Binding="{Binding Key}" Width="1*"/><DataGridTextColumn Header="هزینه تخمینی" Binding="{Binding CostText}" Width="1.4*"/><DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="1.4*"/><DataGridTextColumn Header="سود خالص فروش" Binding="{Binding ProfitText}" Width="1.4*"/><DataGridTextColumn Header="هزینه ثابت" Binding="{Binding FixedText}" Width="1.4*"/><DataGridTextColumn Header="نتیجه ماه" Binding="{Binding NetText}" Width="1.4*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding OutcomeText}" Width="1*"/></DataGrid.Columns></DataGrid></Grid>
</Grid>
<Grid x:Name="SupportPage" Margin="20" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource PageTitle}"/><TextBlock Text="مدیریت نسخه‌های محلی اطلاعات این برنامه" Style="{StaticResource MutedText}" Margin="0,4,0,12"/></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Panel}"><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="پشتیبان خودکار" Style="{StaticResource CardTitle}"/><TextBlock x:Name="AutoBackupState" Style="{StaticResource MutedText}" Margin="0,8,0,8"/><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><CheckBox x:Name="AutoBackup" Content="فعال‌سازی پشتیبان خودکار هنگام خروج" Style="{StaticResource TrendCheckBox}" HorizontalAlignment="Right" Checked="AutoBackupChanged" Unchecked="AutoBackupChanged"/></StackPanel><TextBlock x:Name="LastAutoBackup" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="پشتیبان دستی و بازیابی" Style="{StaticResource CardTitle}"/><TextBlock x:Name="LastManualBackup" Style="{StaticResource MutedText}" Margin="0,8,0,8"/><WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><Button Content="ذخیره نسخه پشتیبان" Click="Backup" Style="{StaticResource Primary}"/><Button Content="بازیابی پشتیبان" Click="Restore"/><Button Content="بازکردن پوشه پشتیبان‌ها" Click="OpenBackupFolder"/></WrapPanel></StackPanel></Border></Grid></StackPanel></ScrollViewer></Grid>
<Grid x:Name="AboutPage" Margin="20" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}" Padding="30"><Grid FlowDirection="LeftToRight" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,32,0" FlowDirection="RightToLeft" VerticalAlignment="Center"><TextBlock Text="وبـیـــلـو" FontSize="30" FontWeight="Bold" Foreground="#6D28D9" TextAlignment="Right"/><TextBlock Text="طراحی و توسعهٔ راهکارهای نرم‌افزاری کسب‌وکار" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" Margin="0,7,0,0"/><TextBlock Text="توسعه‌دهنده: Sadegh Malekzadeh" Style="{StaticResource MutedText}" TextAlignment="Right" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Width="136" Height="136" Background="#F6F1FF" CornerRadius="18" Padding="14"><Image Source="pack://application:,,,/Assets/webilo-logo.png" Width="100" Height="100" Stretch="Uniform"/></Border></Grid></Border><Border Style="{StaticResource Panel}"><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right"><TextBlock Text="سامانه مدیریت سود فروش" Style="{StaticResource CardTitle}"/><TextBlock Text="محاسبهٔ هزینه تخمینی هر فروش بر پایهٔ قیمت همان فروش و درصدهای تأییدشدهٔ برند انجام می‌شود. داده‌ها فقط روی همین رایانه نگهداری می‌شوند." TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock x:Name="AboutVersion" Style="{StaticResource MutedText}" Margin="0,0,0,12"/><Button Content="کپی اطلاعات نسخه" Click="CopyVersion" HorizontalAlignment="Right"/></StackPanel></Border><Border Background="#F6F1FF" BorderBrush="#E6D9FF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="6"><TextBlock Text="Powered by Webilo · Sadegh Malekzadeh" Foreground="#6D28D9" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Center" HorizontalAlignment="Stretch"/></Border></StackPanel></ScrollViewer></Grid>
</Grid>
</Border>
<Border Grid.Column="1" Style="{StaticResource Panel}" Padding="10"><StackPanel><Button Content="داشبورد" Tag="dashboard" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/><Button Content="فروش‌ها" Tag="sales" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/><Button Content="برندها" Tag="brands" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/><Button Content="کدهای ناشناخته" Tag="unknown" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/><Button Content="گزارش‌ها" Tag="reports" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/><Button Content="پشتیبان و راهنما" Tag="support" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/><Button Content="درباره" Tag="about" Click="NavClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Right"/></StackPanel></Border>
</Grid>
<TextBlock Grid.Row="2" x:Name="Status" Foreground="#667085" Margin="28,0,28,8" FontSize="11"/>
</Grid>
<Window.ContextMenu><ContextMenu><MenuItem Header="بستن / باز کردن ماه" Click="ToggleMonthClosed"/></ContextMenu></Window.ContextMenu>
</Window>
