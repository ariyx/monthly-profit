<Border Style="{StaticResource Panel}">
<StackPanel FlowDirection="RightToLeft">
<StackPanel HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
<TextBlock Text="گزارش ماه‌ها" Style="{StaticResource PageTitle}"/>
<TextBlock Text="مقایسه عملکرد، فیلتر بازه و روند مالی" Style="{StaticResource MutedText}" TextAlignment="Right" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
</StackPanel>
