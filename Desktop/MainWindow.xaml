<WrapPanel DockPanel.Dock="Right" FlowDirection="RightToLeft" HorizontalAlignment="Right">
<Border Background="#FAFBFD" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="9" Padding="8,4" Margin="4">
<WrapPanel FlowDirection="RightToLeft">
