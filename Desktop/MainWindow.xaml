<DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="1.05*" ElementStyle="{StaticResource TableText}"/>
</DataGrid.Columns>
</DataGrid>
</StackPanel>
</Border>
</StackPanel>
</Grid>
</ScrollViewer>
</TabItem>
<TabItem Header="خریدها">
<DockPanel Margin="22">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="خریدهای ماه انتخاب‌شده" Style="{StaticResource PageTitle}"/>
<TextBlock x:Name="PurchaseSummary" Style="{StaticResource MutedText}" Margin="0,5,0,12"/>
